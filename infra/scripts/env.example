# Copy this file to .env, edit values, then run:
# source .env

export AWS_REGION="ap-south-1"
export CLUSTER_NAME="interview-eks"
export K8S_VERSION="1.34"

# Your purchased domain and the app hostname you want to expose through ALB.
export DOMAIN_NAME="example.com"
export APP_HOSTNAME="app.example.com"

# GitHub repository that will deploy through OIDC.
export GITHUB_OWNER="your-github-user-or-org"
export GITHUB_REPO="eks-interview-lab"
export GITHUB_BRANCH="main"

export NAMESPACE="interview"
export HELM_RELEASE="interview-app"
export ECR_REPOSITORY="interview-app"
export IMAGE_TAG="manual-$(date +%Y%m%d%H%M)"

# Leave empty initially. Scripts will print values you can paste back here.
export CERTIFICATE_ARN=""
export APP_ROLE_ARN=""
export GITHUB_ACTIONS_ROLE_ARN=""

# Optional: use linux/arm64 if you choose Graviton nodes.
export DOCKER_PLATFORM="linux/amd64"
