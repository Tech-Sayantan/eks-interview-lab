{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDemoBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__IRSA_BUCKET_NAME__"
    },
    {
      "Sid": "UseDemoBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::__IRSA_BUCKET_NAME__/*"
    }
  ]
}
